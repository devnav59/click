<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="12dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header - Drag handle -->
        <LinearLayout
            android:id="@+id/headerDrag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:gravity="center">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_drag_handle"
                android:alpha="0.3"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="پنل شناور اتوکلیک"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1A1C1E"/>

                    <TextView
                        android:id="@+id/txtFloatingStatusFull"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="آماده"
                        android:textSize="11sp"
                        android:textColor="#6750A4"/>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnFloatingMinimize"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/arrow_down_float"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="minimize"/>

                <ImageButton
                    android:id="@+id/btnFloatingCloseFull"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="close"/>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E7E0EC"
            android:alpha="0.6"/>

        <!-- Segmented control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabTasks"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="وظایف"
                    app:cornerRadius="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabCurrent"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="وظیفه فعال"
                    app:cornerRadius="12dp"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- Tasks section -->
        <LinearLayout
            android:id="@+id/sectionTasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="وظایف من"
                    android:textStyle="bold"
                    android:textSize="13sp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateTaskFloat"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="+ جدید"
                    android:textSize="12sp"
                    app:cornerRadius="12dp"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTasksFloat"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:clipToPadding="false"
                android:paddingBottom="4dp"/>

            <TextView
                android:id="@+id/txtEmptyFloat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="هنوز وظیفه‌ای نساختی — یک وظیفه جدید بساز"
                android:gravity="center"
                android:padding="16dp"
                android:textColor="#888"
                android:textSize="12sp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Current task section -->
        <LinearLayout
            android:id="@+id/sectionCurrent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:strokeColor="#E7E0EC"
                app:strokeWidth="1dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/txtCurrentTaskName"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textStyle="bold"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/txtCurrentCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 اقدام"
                            android:textSize="11sp"
                            android:background="@drawable/bg_chip"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtCurrentPkg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="همه اپ‌ها"
                        android:textSize="11sp"
                        android:textColor="#666"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Params -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="پارامترهای اعشاری"
                    android:textStyle="bold"
                    android:textSize="12sp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddParamFloat"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="+ عدد"
                    android:textSize="11sp"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerParamsFloat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="110dp"/>

            <!-- Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="مراحل ضبط‌شده"
                    android:textStyle="bold"
                    android:textSize="12sp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddInputFloat"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="+ ورودی"
                    android:textSize="11sp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearFloat"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="پاک"
                    android:textSize="11sp"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerActionsFloat"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:clipToPadding="false"/>

            <!-- Tip -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="نکته: اپ هدف را به صورت پنجره شناور (Freeform) باز کن تا همزمان پنل را ببینی. دکمه‌های ضبط ذخیره نمی‌شوند."
                android:textSize="10sp"
                android:textColor="#888"
                android:background="#F3F0F7"
                android:padding="8dp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Bottom controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:background="#F8F5FF">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFloatingRecFull"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="● شروع ضبط"
                app:cornerRadius="12dp"/>

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFloatingPlayFull"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="▶ اجرا"
                app:cornerRadius="12dp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
