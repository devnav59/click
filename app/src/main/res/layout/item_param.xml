<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <android.widget.EditText android:id="@+id/editLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="نام (مثلا قیمت 1)" android:textSize="12sp" android:background="@android:color/transparent" android:padding="2dp"/>
            <android.widget.EditText android:id="@+id/editValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="عدد اعشاری مثلا 12.34" android:inputType="numberDecimal|numberSigned" android:textSize="14sp"/>
            <TextView android:id="@+id/txtHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#888"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnDeleteParam" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="حذف" style="@style/Widget.Material3.Button.TextButton"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
