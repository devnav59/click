<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="متن ورودی (می‌تواند به پارامتر وصل شود)" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="اگر به پارامتر وصل کنی، مقدار فعلی آن پارامتر در هر اجرا جایگذاری می‌شود." android:textSize="11sp" android:textColor="#666" android:layout_marginBottom="8dp"/>
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/editInputText" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="متن یا عدد مثلا 12.34 یا {{p0}}"/>
    </com.google.android.material.textfield.TextInputLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="اتصال به پارامتر:" android:layout_marginTop="12dp"/>
    <Spinner android:id="@+id/spinnerParam" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="نکته: گزینه 'مقدار ثابت' یعنی همین متن ثابت تایپ شود. گزینه پارامترها یعنی شماره مربوطه به ترتیب اجرا شود." android:textSize="10sp" android:textColor="#888" android:layout_marginTop="8dp"/>
</LinearLayout>
